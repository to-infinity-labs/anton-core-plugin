#!/usr/bin/env bash
# Canonical skill-invocation surface. Sources lib/wrapper.sh, which owns the
# one data-root and pinned-binary resolver the Go CLI agrees with, then execs
# the binary. Hooks source lib/wrapper.sh directly; this is the equivalent
# entry point for everything skills invoke. Terminal use does NOT come through
# here: /anton-core:setup installs a separate minimal launcher
# (scripts/core-shim.sh -> <data>/data/bin/core) that the ~/.local/bin/anton
# symlink points at, so a bare-shell `anton` execs the live
# data/versions/current pointer instead of this version-pinned shim. Inside a
# session that launcher delegates to bin/anton, which execs this shim.
#
# Symlink-safe: resolves $0 via readlink so the plugin root derives
# correctly even if this shim is itself reached through a symlink (dev
# checkouts, test harnesses) -- otherwise dirname "$0" could misresolve.
set -euo pipefail

# Resolve self to absolute path even when invoked via a symlink.
# macOS lacks `readlink -f`; loop manually for portability. POSIX SYMLOOP_MAX
# is 8; 40 hops gives headroom for nested workspace symlinks while killing
# cyclic-symlink hangs (e.g. `a -> b, b -> a`) in well under a second.
# macOS readlink itself does not detect cycles, so the cap is load-bearing.
_script_path="$0"
_link_hops=0
while [[ -L "$_script_path" ]]; do
    _link_hops=$((_link_hops + 1))
    if [[ $_link_hops -gt 40 ]]; then
        printf '{"status":"error","error":{"kind":"precondition_missing","reason":"symlink_loop","detail":"more than 40 symlink hops resolving %s — refusing to continue; check %s and ancestors for a cyclic symlink"}}\n' \
            "$0" "$0" >&2
        exit 2
    fi
    if ! _readlink_out="$(readlink "$_script_path" 2>&1)"; then
        # readlink can fail for reasons distinct from cyclic-link (broken
        # target with EPERM on the link, ACL denying read, race with an
        # unlink between -L test and readlink). set -e would otherwise
        # abort silently here; emit the skill-shape envelope so the
        # operator sees the actual cause instead of exit 1 with no stderr.
        _readlink_msg="$(printf '%s' "$_readlink_out" | tr -d '\000-\037' | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')"
        printf '{"status":"error","error":{"kind":"precondition_missing","reason":"readlink_failed","detail":"readlink failed on %s: %s; check link permissions and target existence"}}\n' \
            "$_script_path" "${_readlink_msg:-<no stderr>}" >&2
        exit 2
    fi
    _target="$_readlink_out"
    case "$_target" in
        /*) _script_path="$_target" ;;
        *)  _script_path="$(cd "$(dirname "$_script_path")" && cd "$(dirname "$_target")" && pwd)/$(basename "$_target")" ;;
    esac
done
_script_dir="$(cd "$(dirname "$_script_path")" && pwd)"

# The plugin root wrapper.sh falls back to when the harness names none.
_anton_self_root="$(cd "$_script_dir/.." && pwd)"

# --wrapper-check: operator probe. Resolves and prints the paths without
# invoking the binary. JSON via jq when available; sed-escape fallback
# otherwise so the diagnostic survives backslashes or doublequotes.
if [[ "${1:-}" == "--wrapper-check" ]]; then
    # Parse-check the sourced wrapper before sourcing it: a bash 4-only
    # construct would otherwise explode on the next `core <verb>` while this
    # diagnostic still looked clean. Prefer /bin/bash so macOS checks 3.2.
    if [[ -x /bin/bash ]]; then
        _wrapper_parse_bash=/bin/bash
    else
        _wrapper_parse_bash=bash
    fi
    wrapper_parses=false
    _anton_root=""
    _anton_root_src=""
    ANTON_BIN=""
    ANTON_PLUGIN_ROOT="${CLAUDE_PLUGIN_ROOT:-${PLUGIN_ROOT:-$_anton_self_root}}"
    if "$_wrapper_parse_bash" -n "$_script_dir/lib/wrapper.sh" 2>/dev/null; then
        wrapper_parses=true
        # shellcheck source=lib/wrapper.sh disable=SC1091
        ANTON_RESOLVE_ONLY=1 source "$_script_dir/lib/wrapper.sh"
        # The live resolution, so the report cannot lie about which binary a
        # `core <verb>` would exec; a drifted pin reports its missing slot.
        [[ -n "$_anton_root" ]] && { _resolve_pinned_bin "$_anton_root" 2>/dev/null || true; }
    fi
    version=""
    for _manifest in "$ANTON_PLUGIN_ROOT/.claude-plugin/plugin.json" "$ANTON_PLUGIN_ROOT/.codex-plugin/plugin.json"; do
        version="$(grep -E '"version"' "$_manifest" 2>/dev/null \
            | head -1 \
            | sed -E 's/.*"version"[[:space:]]*:[[:space:]]*"([^"]+)".*/\1/' \
            || true)"
        [[ -n "$version" ]] && break
    done
    # An empty version would report a phantom binary path; fail instead.
    if [[ -z "$version" ]]; then
        printf '{"status":"error","error":{"kind":"precondition_missing","reason":"missing_manifest_version","detail":"could not read .version from %s/.claude-plugin/plugin.json or .codex-plugin/plugin.json (missing, unreadable, or malformed); re-install the plugin or run the setup skill"}}\n' \
            "$ANTON_PLUGIN_ROOT" >&2
        exit 2
    fi
    bin_path="$ANTON_BIN"
    if [[ -x "$bin_path" ]]; then
        bin_exists=true
    else
        bin_exists=false
    fi
    # bootstrap-fetch.sh refuses to install inside a harness-managed cache or
    # marketplace clone; report whether the live binary sits in one.
    case "$bin_path" in
        */plugins/cache/*|*/plugins/marketplaces/*) bin_in_managed_cache=true ;;
        *) bin_in_managed_cache=false ;;
    esac
    # wrapper.sh prefers a `make build` binary over an empty pin; report it so a
    # dev checkout does not read as bin_exists=false while it runs.
    dev_bin="$ANTON_PLUGIN_ROOT/bin/anton-core"
    if [[ -x "$dev_bin" ]]; then
        dev_bin_exists=true
    else
        dev_bin_exists=false
    fi
    # The sed fallback escapes only `\` and `"`; a control byte (legal in POSIX
    # paths) would emit invalid JSON, so refuse it.
    case "$ANTON_PLUGIN_ROOT$_anton_root$bin_path$dev_bin$version" in
        *[[:cntrl:]]*)
            printf '{"status":"error","error":{"kind":"precondition_missing","reason":"control_byte_in_path","detail":"resolved path or version contains a control byte (newline/tab/etc); refusing to emit corrupt JSON. Check the plugin root and CORE_DATA_DIR."}}\n' >&2
            exit 2
            ;;
    esac
    if command -v jq >/dev/null 2>&1; then
        jq -nc \
            --arg pr  "$ANTON_PLUGIN_ROOT" \
            --arg pd  "$_anton_root" \
            --arg drs "$_anton_root_src" \
            --arg v   "$version" \
            --arg bp  "$bin_path" \
            --argjson be "$bin_exists" \
            --argjson bmc "$bin_in_managed_cache" \
            --arg db  "$dev_bin" \
            --argjson dbe "$dev_bin_exists" \
            --argjson wp "$wrapper_parses" \
            '{plugin_root:$pr, plugin_data:$pd, data_root:$pd, data_root_source:$drs, version:$v, bin:$bp, bin_exists:$be, bin_in_managed_cache:$bmc, dev_bin:$db, dev_bin_exists:$dbe, wrapper_parses:$wp}'
    else
        _esc() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }
        printf '{"plugin_root":"%s","plugin_data":"%s","data_root":"%s","data_root_source":"%s","version":"%s","bin":"%s","bin_exists":%s,"bin_in_managed_cache":%s,"dev_bin":"%s","dev_bin_exists":%s,"wrapper_parses":%s}\n' \
            "$(_esc "$ANTON_PLUGIN_ROOT")" \
            "$(_esc "$_anton_root")" \
            "$(_esc "$_anton_root")" \
            "$(_esc "$_anton_root_src")" \
            "$(_esc "$version")" \
            "$(_esc "$bin_path")" \
            "$bin_exists" \
            "$bin_in_managed_cache" \
            "$(_esc "$dev_bin")" \
            "$dev_bin_exists" \
            "$wrapper_parses"
    fi
    exit 0
fi

# Defer the hook-shape "exit 0 with envelope on stdout" path inside
# wrapper.sh so the shim can re-emit a skill-shape error on stderr
# with a non-zero exit (see post-source block below).
ANTON_DEFER_BOOTSTRAP_ERROR=1
export ANTON_DEFER_BOOTSTRAP_ERROR

# Guard the source call itself. A parse error in lib/wrapper.sh, a
# missing file, or any pre-source-completion `set -e` abort would
# otherwise bypass the post-source envelope below and leak raw bash
# diagnostics to stderr -- regressing the very contract this shim
# exists to enforce (skill-shape JSON or nothing). Catch the failure
# here and emit a wrapper_source_failed envelope.
_wrapper_src_err="$(mktemp "${TMPDIR:-/tmp}/anton-shim-src.XXXXXX" 2>/dev/null || echo "${TMPDIR:-/tmp}/anton-shim-src.$$.err")"
# shellcheck source=lib/wrapper.sh disable=SC1091
if ! source "$_script_dir/lib/wrapper.sh" 2>"$_wrapper_src_err"; then
    _src_status=$?
    # The wrapper's own pin-drift refusal already carries its message and
    # envelope; pass them through rather than recasting them.
    if grep -q '"reason":"pin_drift_fatal"' "$_wrapper_src_err" 2>/dev/null; then
        cat "$_wrapper_src_err" >&2
        rm -f "$_wrapper_src_err"
        exit 2
    fi
    _src_msg=""
    if [[ -s "$_wrapper_src_err" ]]; then
        _src_msg="$(head -1 "$_wrapper_src_err" 2>/dev/null || true)"
    fi
    rm -f "$_wrapper_src_err"
    _src_msg_esc="$(printf '%s' "${_src_msg:-<no stderr>}" | tr -d '\000-\037' | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')"
    printf '{"status":"error","error":{"kind":"precondition_missing","reason":"wrapper_source_failed","detail":"failed to source scripts/lib/wrapper.sh (exit %s): %s; run scripts/core --wrapper-check for path diagnostics"}}\n' \
        "$_src_status" "$_src_msg_esc" >&2
    exit 2
fi
rm -f "$_wrapper_src_err"

# Missing-binary precondition. The sourced wrapper (hooks answer or enqueue)
# resolves the pin / dev build / staged slot but NEVER fetches; it
# defers the print via ANTON_DEFER_BOOTSTRAP_ERROR so this shim owns the
# skill-shape envelope. When nothing resolved to an executable binary, emit the
# precondition envelope on stderr (skills treat stdout as data, so the error
# must go to stderr) and exit 2 — a real non-zero status for skill bodies and
# operator shells. Installing the binary is /anton-core:setup's job (via
# scripts/lib/bootstrap-fetch.sh), never this shim's; scripts/core stays
# curl-free by contract.
if [[ ! -x "${ANTON_BIN:-}" ]]; then
    # shellcheck disable=SC2016  # $anton-core:setup is Codex's skill syntax, not an expansion
    printf '{"status":"error","error":{"kind":"precondition_missing","reason":"binary_missing_run_setup","detail":"anton-core binary not found; run the setup skill (/anton-core:setup, or $anton-core:setup in Codex) to install it."}}\n' >&2
    exit 2
fi

# Reached only when ANTON_BIN is an executable binary (guarded above).
exec "$ANTON_BIN" "$@"
